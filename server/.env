# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/visionsync
MONGODB_TEST_URI=mongodb://localhost:27017/visionsync_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# S3 Buckets
S3_RAW_VIDEOS_BUCKET=raw-sync-videos-bucket
S3_PROCESSED_VIDEOS_BUCKET=processed-sync-videos-bucket

# SQS
SQS_VIDEO_PROCESSING_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/account/video-processing-queue

# Security
JWT_SECRET=your_jwt_secret_key
WEBHOOK_SECRET=your_webhook_secret

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=1073741824
ALLOWED_MIME_TYPES=video/mp4,video/avi,video/mov,video/mkv

# Processing
VIDEO_PROCESSING_TIMEOUT=3600