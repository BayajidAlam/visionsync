# Backend-only inventory template

[backend]
backend-server ansible_host={{ backend_private_ip }}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file={{ ssh_key_path | default('~/.ssh/vision-sync-backend') }}
ansible_ssh_common_args=-o StrictHostKeyChecking=no
aws_region={{ aws_region | default('ap-southeast-1') }}
