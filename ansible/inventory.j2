[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file={{ ssh_private_key_file }}
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[bastion]
bastion ansible_host={{ bastion_public_ip }}

[frontend]
frontend ansible_host={{ frontend_public_ip }}

[backend]
backend ansible_host={{ backend_private_ip }} ansible_ssh_common_args='-o ProxyJump=ubuntu@{{ bastion_public_ip }} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[mongodb]
mongodb-1 ansible_host={{ mongodb_primary_ip }} ansible_ssh_common_args='-o ProxyJump=ubuntu@{{ bastion_public_ip }} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
mongodb-2 ansible_host={{ mongodb_secondary_ip }} ansible_ssh_common_args='-o ProxyJump=ubuntu@{{ bastion_public_ip }} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
mongodb-3 ansible_host={{ mongodb_arbiter_ip }} ansible_ssh_common_args='-o ProxyJump=ubuntu@{{ bastion_public_ip }} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

[redis]
redis ansible_host={{ redis_private_ip }} ansible_ssh_common_args='-o ProxyJump=ubuntu@{{ bastion_public_ip }} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
